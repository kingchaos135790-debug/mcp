# Shared paths for the MCP server and repository manager.
# Workspace paths are relative to this file; INDEX_ROOT may be absolute.
MCP_DIR=windows-code-search-mcp
WINDOWS_MCP_DIR=Windows-MCP
SEARCH_ENGINE_DIR=ripgrep-treesitter-qdrant-mcp
INDEX_ROOT=E:\Program Files\mcp-index-data
QDRANT_ROOT=..\qdrant

# Optional public OAuth configuration.
# Prefer OAUTH_CLIENT_SECRET_FILE on an NTFS volume instead of storing a secret here.
OAUTH_ENABLED=false
OAUTH_BASE_URL=
OAUTH_REDIRECT_URIS=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET_FILE=
OAUTH_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post
OAUTH_REQUIRED_SCOPES=mcp:access
OAUTH_VALID_SCOPES=mcp:access,offline_access
OAUTH_ALLOW_DYNAMIC_CLIENT_REGISTRATION=false
OAUTH_STATE_MAX_TOKENS=50
